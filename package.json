{
  "name": "fanbox",
  "version": "2.16.1",
  "description": "FanBox — the cockpit for coding agents. Command Claude Code or Codex, watch every file and line they change, and take over anytime.",
  "bin": {
    "fanbox": "server.js"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "rebuild:pty": "cd node_modules/node-pty && node-gyp rebuild --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://www.electronjs.org/headers --arch=$PTY_ARCH",
    "build:milkdown": "esbuild src-vendor/milkdown-entry.js --bundle --format=iife --minify --outfile=public/vendor/milkdown/milkdown.js --loader:.svg=dataurl --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.eot=file --asset-names=[name]",
    "build:hljs": "esbuild src-vendor/hljs-entry.js --bundle --format=iife --minify --outfile=public/vendor/hljs/highlight.js && cp node_modules/marked/marked.min.js public/vendor/marked/marked.min.js && cp node_modules/dompurify/dist/purify.min.js public/vendor/dompurify/purify.min.js && cp node_modules/highlight.js/styles/github-dark.min.css node_modules/highlight.js/styles/github.min.css public/vendor/hljs/styles/",
    "dist": "APPLE_KEYCHAIN_PROFILE=fanbox-notary electron-builder --mac --arm64 --publish never",
    "dist:x64": "PTY_ARCH=x64 npm run rebuild:pty && APPLE_KEYCHAIN_PROFILE=fanbox-notary electron-builder --mac --x64 --publish never && PTY_ARCH=arm64 npm run rebuild:pty",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:win:arm64": "electron-builder --win --arm64 --publish never"
  },
  "build": {
    "appId": "com.huashu.fanbox",
    "productName": "FanBox",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.claude{,/**/*}",
      "!dist{,/**/*}",
      "!_archive{,/**/*}",
      "!design-demos{,/**/*}",
      "!experiments{,/**/*}",
      "!docs{,/**/*}",
      "!素材{,/**/*}",
      "!assets{,/**/*}",
      "!src-vendor{,/**/*}",
      "!.icon.html",
      "!.DS_Store",
      "!**/.DS_Store",
      "!**/node_modules/**/*.{tlog,obj,pdb,iobj,ipdb,vcxproj,filters,lastbuildstate,recipe,exp,ilk}",
      "!**/node_modules/**/Release/obj/**",
      "!**/node_modules/node-pty/build/Release/.deps/**",
      "!**/node_modules/node-pty/src/**",
      "!**/node_modules/node-pty/deps/**/*.{cc,h,cpp,gyp,gypi}"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "chen yunfei (KQQ39VZPW6)",
      "notarize": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "终端里的 agent 需要通过它控制其他 app（截图、取窗口信息、驱动剪映等）。"
      },
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alchaincyf",
        "repo": "fanbox"
      }
    ],
    "dmg": {
      "title": "FanBox",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FanBox",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@milkdown/crepe": "^7.21.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "node-gyp": "^12.4.0"
  },
  "license": "MIT"
}
